# 换行符：仓库内统一 LF，检出到工作副本时按下面的规则处理。
# 不写这一层的话，core.autocrlf=true 的机器会把 gradlew 检出成 CRLF，
# 在 macOS / Linux 上直接以 “bad interpreter” 失败。
* text=auto

# 脚本
gradlew  text eol=lf
*.sh     text eol=lf
*.bat    text eol=crlf

# 源码、工程文件与文本资源
*.cs       text eol=lf
*.csproj   text eol=lf
*.xaml     text eol=lf
*.kt       text eol=lf
*.kts      text eol=lf
*.gradle   text eol=lf
*.swift    text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.xml      text eol=lf
*.ps1      text eol=lf
*.pbxproj  text eol=lf
*.properties text eol=lf

# 二进制，不做任何转换
*.png  binary
*.jpg  binary
*.ico  binary
*.jar  binary
