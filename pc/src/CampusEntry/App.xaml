<Application x:Class="CampusEntry.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!--
            DESIGN.md 的 PC 落地层。

            颜色 token 与 Android 端完全一致（同一套设计系统）；但字号与密度**不能照搬手机**：
            DESIGN.md 的 typography 是手机规范（labelSmall 11px 是给 6 寸屏的底栏标签用的），
            直接当 WPF 的 DIP 用会得到「大框小字」。桌面按 Windows 惯例重新定义下面这一档，
            角色与 DESIGN.md 一一对应，只是换了数值。
        -->

        <!-- === 颜色（同 DESIGN.md） -->
        <SolidColorBrush x:Key="Brush.Primary" Color="#2F6FB5"/>
        <SolidColorBrush x:Key="Brush.PrimaryDeep" Color="#24548A"/>
        <SolidColorBrush x:Key="Brush.Ink" Color="#1A1C1E"/>
        <SolidColorBrush x:Key="Brush.Secondary" Color="#6C7278"/>
        <SolidColorBrush x:Key="Brush.Neutral" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Brush.Line" Color="#E3E3E3"/>
        <SolidColorBrush x:Key="Brush.Success" Color="#2E7D5B"/>
        <SolidColorBrush x:Key="Brush.Warning" Color="#8F5500"/>
        <SolidColorBrush x:Key="Brush.Error" Color="#B3261E"/>

        <!-- PC 新增：窗口外框、悬停/按下态、窗口按钮关闭态。都不是新语义，只是桌面特有的状态层 -->
        <SolidColorBrush x:Key="Brush.WindowBorder" Color="#D5DAE0"/>
        <SolidColorBrush x:Key="Brush.Hover" Color="#EDF1F6"/>
        <SolidColorBrush x:Key="Brush.Pressed" Color="#E2E9F1"/>
        <SolidColorBrush x:Key="Brush.CaptionHover" Color="#E9EDF2"/>
        <SolidColorBrush x:Key="Brush.CloseHover" Color="#C42B1C"/>
        <SolidColorBrush x:Key="Brush.ClosePressed" Color="#B02318"/>

        <!-- === PC 字号层级（DIP） -->
        <sys:Double x:Key="Type.Caption">12</sys:Double>
        <sys:Double x:Key="Type.Body">13</sys:Double>
        <sys:Double x:Key="Type.Label">13</sys:Double>
        <sys:Double x:Key="Type.Title">15</sys:Double>
        <sys:Double x:Key="Type.AppName">13</sys:Double>

        <!-- === 图标字体 -->
        <!--
            Windows 的原生图标字体，矢量、随 DPI 重光栅化、颜色跟随 Foreground。
            旧实现用「←」「→」「⟳」「⚙」这类文本字形充当图标，它们来自 Segoe UI / 符号字体的
            回退链：笔画粗细、字形大小、基线彼此不一致，在高 DPI 下无法对齐也无法统一换色。
            Segoe Fluent Icons 是 Win11 的图标字体（Segoe MDL2 Assets 作为 Win10 回退）。
        -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- === 界面字体 -->
        <!--
            DESIGN.md 说 fontFamily 用 system-ui，Windows 的等价物是「拉丁走 Segoe UI、汉字走
            Microsoft YaHei UI」。写成逗号列表让 WPF **逐字符**挑字体，而不是靠它内置的
            GlobalUserInterface 回退表去猜——不显式写出来，中文落在哪个字体族上就不由我们控制。
        -->
        <FontFamily x:Key="AppFont">Segoe UI, Microsoft YaHei UI</FontFamily>

        <!-- === 工具栏：图标按钮 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Ink}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Hover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Pressed}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Secondary}"/>
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- === 工具栏：入口页签 -->
        <!--
            用 RadioButton 而不是 Button：这两个入口是「当前入口」的互斥选择，
            IsChecked 天然表达状态，无障碍读屏也会正确播报，不需要在代码里手工换 Foreground。
        -->
        <Style x:Key="ToolbarTab" TargetType="RadioButton">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
            <!--
                刻意不设 FontWeight。DESIGN.md 的 labelXxx 字重是 500，但 **Windows 上没有任何 500
                字重的中文字面**，WPF 只能就近取到 600(Semibold)，标签就比设计意图粗了一档
                （实测截图与同字号 Regular 对比明显偏粗）。桌面档按 400 走，强调只留给真正的标题（600）。
                与桌面字号一样，属于「手机档不能直接搬过来」的坑。
            -->
            <Setter Property="Foreground" Value="{StaticResource Brush.Secondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                            <!-- 选中指示条：底边 2px 主色 -->
                            <Border x:Name="Indicator" Height="2" VerticalAlignment="Bottom"
                                    Background="{StaticResource Brush.Primary}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Ink}"/>
                            </Trigger>
                            <!-- 放在 IsMouseOver 之后：选中的页签即使被悬停也保持主色 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>
                                <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- === 工具栏：带文字的按钮（设置） -->
        <Style x:Key="ToolbarTextButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Ink}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Hover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Pressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- === 标题栏：窗口按钮 -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Ink}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.CaptionHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Pressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 关闭键：Windows 惯例是悬停变红底白字，这是唯一允许用红色的地方 -->
        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.CloseHover}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.ClosePressed}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- === 对话框：按钮 -->
        <!-- button-ghost / button-danger-text（DESIGN.md）：破坏性动作永远是描边或文字按钮，不做实心红 -->
        <Style x:Key="ButtonGhost" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Label}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>
            <Setter Property="Background" Value="{StaticResource Brush.Neutral}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E7EDF5"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#DBE5F0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ButtonDanger" TargetType="Button" BasedOn="{StaticResource ButtonGhost}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Error}"/>
            <Setter Property="Background" Value="#FDF2F1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FBE7E5"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#F8DBD8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- === 对话框：复选框 -->
        <!-- 系统默认的 WPF CheckBox 是 Aero 时代的方块，与这套设计语言不搭，按 DESIGN.md 重画 -->
        <Style x:Key="AppCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Brush.Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="4"
                                    Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="1.5"
                                    VerticalAlignment="Top" Margin="0,3,12,0">
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                           FontSize="12" Foreground="White" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Primary}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
